+import pandas as pd
+
+from fundamental_official_filings import apply_official_publication_dates
+
+
+def test_valid_previous_verification_is_reported_as_preserved_not_unverified(tmp_path):
+    records = pd.DataFrame([{
+        "TckrSymb": "ABCOTS",
+        "FinancialPeriodEnd": "2026-03-31",
+        "PublicationDate": "2026-05-27",
+        "PublicationDateStatus": "VERIFIED",
+        "OfficialFilingURL": "https://nsearchives.nseindia.com/corporate/xbrl/ABCOTS.xml",
+        "OfficialFilingSource": "NSE Integrated Filing - Financials",
+    }])
+    # A non-empty official filings table that has no exact ABCOTS period pair
+    # models the bulk/targeted lookup miss seen in the report diagnostics.
+    filings = pd.DataFrame([{
+        "TckrSymb": "OTHER",
+        "FinancialPeriodEnd": "2026-03-31",
+        "PublicationDate": "2026-05-20",
+        "PublicationDateStatus": "VERIFIED",
+        "OfficialFilingURL": "https://nsearchives.nseindia.com/corporate/xbrl/OTHER.xml",
+        "OfficialSource": "NSE Integrated Filing - Financials",
+    }])
+    diagnostic_path = tmp_path / "verification.csv"
+    out = apply_official_publication_dates(
+        records,
+        "2026-11-02",
+        filings=filings,
+        cache_path=tmp_path / "filings_cache.csv",
+        diagnostics_path=diagnostic_path,
+    )
+
+    assert out.loc[0, "PublicationDateStatus"] == "VERIFIED"
+    assert out.loc[0, "PublicationDate"] == "2026-05-27"
+    diag = pd.read_csv(diagnostic_path)
+    row = diag.loc[diag["TckrSymb"].eq("ABCOTS")].iloc[0]
+    assert row["Status"] == "PRESERVED_PREVIOUSLY_VERIFIED"
+    assert row["PublicationDate"] == "2026-05-27"
